# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Cache TTL in seconds
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=500

# Upstream request timeout in ms
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_MAX_RETRIES=2

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Optional: GitHub personal access token (public_repo scope not required for
# public user stats). Enables commits / PRs / issues / contrib / streak on
# the GitHub cards. Without a token, those fields show "GITHUB_TOKEN not set".
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
